<?php

namespace App\Http\Controllers\Auth\Admin;

use App\Http\Controllers\Controller;
use App\Models\Employee;
use App\Models\User;
use App\Models\Shift;
use Illuminate\Contracts\View\View;
use Illuminate\Http\Request;
use Illuminate\Support\Carbon;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Hash;
use Illuminate\Support\Facades\Validator;
use Illuminate\Support\Facades\File;

class EmployeeController extends Controller
{
    public function index(): View
    {
        //$employees =  Employee::where('status', 'active')->latest()->get();
        $employees = Employee::latest()->get();
        return view('auth.admin.employees.index', compact('employees'));
    }

    public function add()
    {
        return view('auth.admin.employees.create');
    }

    public function create(Request $request)
    {
        $validation = Validator::make($request->all(), [
            'name' => 'required',
            'email' => 'required|email|unique:employees',
            'password' => 'required|min:3|max:15',
            'phone' => 'required',
            'dob' => 'required|date',
            'pay_rate' => 'required',
            'image' => 'nullable|image|mimes:jpg,png,jpeg|max:1024',
        ]);

        if ($validation->fails()) {
            return response()->json([
                'errors' => $validation->errors()
            ], 422); // <- very important!
        }
        else {
            $employee = new Employee();

            $filename = "";
            if ($request->file('image')) {
                $filename = $request->file('image')->store('employee', 'public');
            }

            $employee->name = $request->name;
            $employee->email = $request->email;
            $employee->dob = $request->dob;
            $employee->address = $request->address;
            $employee->pay_rate = $request->pay_rate;
            $employee->phone = $request->phone;
            $employee->password = Hash::make($request->password);
            $employee->image = $filename;
            $employee->status = $request->has('status') ? 'Active' : 'Inactive';

            $result = $employee->save();

            //Adding employee as user in users table
            DB::table('users')->insert([
                //admin
                [
                    'name' => $request->name,
                    'username' => $request->email,
                    'email' => $request->email,
                    'password' => Hash::make($request->password),
                    'role' => 'user',
                    'status' => 'active',
                ],
            ]);

            if ($result) {
                return response()->json([
                    'success' => true,
                    'message' => [
                        'Employee Created Successfully'
                    ]
                ]);
            } else {
                return response()->json([
                    "success" => false,
                    'message' => [
                        'Employee creation failed. Please try again later.'
                    ]
                ]);
            }
        }
    }

    public function edit($id)
    {
        $employee = Employee::findOrFail($id);
        return view('auth.admin.employees.update', compact('employee'));
    }

    public function update(Request $request)
    {
        $validation = Validator::make($request->all(), [
            'name' => 'required',
            'email' => 'required|email',
            'phone' => 'required',
			'password' => 'required|min:3|max:15',
            'dob' => 'required|date',
            'pay_rate' => 'required',
            'image' => 'nullable|image|mimes:jpg,png,jpeg|max:1024',
        ]);

        if ($validation->fails()) {
            return response()->json([
                'errors' => $validation->errors()
            ], 422); // <- very important!
        }
        else {
        $employee = Employee::findOrFail($request->id);
		$user = User::where('email', $employee->email)->first();

        $filename = "";
        $path = public_path('storage\\' . $request->old_image);
        if ($request->file('image')) {
            if (File::exists($path)) {
                File::delete($path);
            }
            $filename = $request->file('image')->store('employee', 'public');
        } else {
            $filename = $request->old_image;
        }

        $employee->name = $request->name;
        $employee->email = $request->email;
        $employee->dob = $request->dob;
        $employee->address = $request->address;
        $employee->phone = $request->phone;
        $employee->image = $filename;
        $employee->password = Hash::make($request->password);
        $employee->pay_rate = $request->pay_rate;
        $employee->status = $request->has('status') ? 'Active' : 'Inactive';

        $result = $employee->save();  

        if ($result) {

          

            return response()->json([
                'success' => true,
                'message' => [
                    'Employee Updated Successfully'
                ]
            ]);
        } else {
            return response()->json([
                "success" => false,
                'message' => [
                    'Employee Update Unsuccessful'
                ]
            ]);
        }
    }
    }

    public function delete(Request $request)
    {
        $id = $request->id;
        $employee = Employee::findOrFail($id);

        // Check if employee is linked to shifts
        if (Shift::where('emp_id', $employee->id)->exists()) {
            // Update status instead of deleting
            $employee->update(['status' => 'Inactive']);
            DB::table('users')->where('email', $employee->email)->update(['status' => 'inactive']);
            return response()->json([
                'success' => true,
                'message' => [
                    'Employee status set to inactive.'
                ]
            ]);
        }
        else
        {
            // If no linked shifts, delete the employee
            $path = public_path('storage\\' . $employee->image);
            if (File::exists($path)) {
                File::delete($path);
            }
            $result = $employee->delete();

            //Delete employee as user in users table
            DB::table('users')->where('email', $employee->email)->delete();

            if ($result) {
                return response()->json([
                    'success' => true,
                    'message' => [
                        'Employee Deleted Successfully'
                    ]
                ]);
            } else {
                return response()->json([
                    "success" => false,
                    'message' => [
                        'Employee deletion Unsuccessful'
                    ]
                ]);
            }
        }
    }
}
